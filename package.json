{
  "name": "codequest",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev --workspace @codequest/backend\" \"npm run dev --workspace @codequest/frontend\"",
    "dev:backend": "npm run dev --workspace @codequest/backend",
    "dev:frontend": "npm run dev --workspace @codequest/frontend",
    "start:backend": "npm run start --workspace @codequest/backend",
    "build": "npm run build --workspace @codequest/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
